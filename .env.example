# 服务端托管的 SiliconFlow 免费模式密钥，不会暴露给浏览器。
SILICONFLOW_API_KEY=

# 可选：限制生产环境允许代理的自定义 AI 域名，多个域名使用英文逗号分隔。
AI_CUSTOM_ENDPOINT_ALLOWLIST=

# 可选：覆盖服务端免费模式允许使用的模型，多个模型使用英文逗号分隔。
AI_FREE_MODEL_ALLOWLIST=

# 默认 false。仅在可信私有部署且确实需要连接本地模型时设置为 true。
ALLOW_PRIVATE_AI_ENDPOINTS=false
